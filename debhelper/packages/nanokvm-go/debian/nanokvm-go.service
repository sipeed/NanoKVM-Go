[Unit]
Description=NanoKVM Go Service

[Service]
Type=simple
ExecStartPre=/kvmapp/scripts/nanokvm_pre.sh
ExecStartPre=-/usr/bin/timeout --kill-after=10s 5s /kvmapp/scripts/migrate.sh
ExecStart=/kvmapp/scripts/nanokvm.sh
TimeoutStartSec=30s
TimeoutStopSec=10
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target

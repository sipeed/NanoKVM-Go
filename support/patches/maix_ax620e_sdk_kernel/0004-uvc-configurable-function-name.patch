--- a/linux/linux-4.19.125/drivers/usb/gadget/function/uvc_configfs.c
+++ b/linux/linux-4.19.125/drivers/usb/gadget/function/uvc_configfs.c
@@ -3104,7 +3104,46 @@
 
 #undef UVCG_OPTS_ATTR
 
+static ssize_t f_uvc_opts_function_name_show(struct config_item *item, char *page)
+{
+	struct f_uvc_opts *opts = to_f_uvc_opts(item);
+	ssize_t ret;
+
+	mutex_lock(&opts->lock);
+	ret = scnprintf(page, PAGE_SIZE, "%s\n", opts->function_name);
+	mutex_unlock(&opts->lock);
+	return ret;
+}
+
+static ssize_t f_uvc_opts_function_name_store(struct config_item *item,
+					      const char *page, size_t len)
+{
+	struct f_uvc_opts *opts = to_f_uvc_opts(item);
+	size_t n = len, i;
+	ssize_t ret = len;
+
+	if (n && page[n - 1] == '\n')
+		n--;
+	if (!n || n >= sizeof(opts->function_name))
+		return -EINVAL;
+	for (i = 0; i < n; i++)
+		if ((unsigned char)page[i] < 0x20 || page[i] == 0x7f)
+			return -EINVAL;
+
+	mutex_lock(&opts->lock);
+	if (opts->refcnt) {
+		ret = -EBUSY;
+	} else {
+		memcpy(opts->function_name, page, n);
+		opts->function_name[n] = '\0';
+	}
+	mutex_unlock(&opts->lock);
+	return ret;
+}
+UVC_ATTR(f_uvc_opts_, function_name, function_name);
+
 static struct configfs_attribute *uvc_attrs[] = {
+	&f_uvc_opts_attr_function_name,
 	&f_uvc_opts_attr_streaming_bulk,
 	&f_uvc_opts_attr_streaming_interval,
 	&f_uvc_opts_attr_streaming_maxpacket,
